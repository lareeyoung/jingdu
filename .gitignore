/Resources/SubtitleEngine/whisper-cli
/Resources/SubtitleEngine/.whisper-cli.*
*.bin
*.gguf
*.safetensors
*.onnx

# Private configuration, signing material, and user data must stay local.
.env
.env.*
!.env.example
private/
BuildSigning/
*.keychain
*.keychain-db
*.p12
*.pfx
*.pem
*.key
*.der
*.cer
*.crt
identity.json
library.json
library.json.*
ScriptResponses/
SubtitleModels/

